<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>OuterWildsHeadTracking</AssemblyName>
    <RootNamespace>OuterWildsHeadTracking</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Reference shared CameraUnlock.Core library (via git submodule at shared/) -->
  <ItemGroup>
    <ProjectReference Include="..\..\cameraunlock-core\csharp\src\CameraUnlock.Core\CameraUnlock.Core.csproj" />
  </ItemGroup>

  <!-- NuGet Package References -->
  <ItemGroup>
    <PackageReference Include="OuterWildsGameLibs" Version="1.1.16.1372">
      <IncludeAssets>compile</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Lib.Harmony" Version="2.4.1">
      <IncludeAssets>compile</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OWML" Version="2.16.2" GeneratePathProperty="true">
      <IncludeAssets>compile</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Unity assembly references with extern aliases -->
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(NuGetPackageRoot)outerwildsgamelibs\1.1.16.1372\lib\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
      <Aliases>UnityCoreModule</Aliases>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(NuGetPackageRoot)outerwildsgamelibs\1.1.16.1372\lib\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
      <Aliases>UnityUI</Aliases>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(NuGetPackageRoot)outerwildsgamelibs\1.1.16.1372\lib\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
      <Aliases>UnityUIModule</Aliases>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(NuGetPackageRoot)outerwildsgamelibs\1.1.16.1372\lib\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- OWML references with extern aliases, resolved from the OWML NuGet
       package so the build is game-independent (no local OWML install). -->
  <ItemGroup>
    <Reference Include="OWML.ModHelper">
      <HintPath>$(PkgOWML)\lib\net48\OWML.ModHelper.dll</HintPath>
      <Private>False</Private>
      <Aliases>OWMLCore</Aliases>
    </Reference>
    <Reference Include="OWML.Common">
      <HintPath>$(PkgOWML)\lib\net48\OWML.Common.dll</HintPath>
      <Private>False</Private>
      <Aliases>OWMLCommon</Aliases>
    </Reference>
    <Reference Include="OWML.ModHelper.Menus">
      <HintPath>$(PkgOWML)\lib\net48\OWML.ModHelper.Menus.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Post-build event -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="echo Build complete." />
  </Target>
</Project>
